{
  "name": "create-python-package",
  "displayName": "Create Python Package",
  "repository": {
    "type": "git",
    "url": "https://github.com/evindunn/vscode-create-python-package-extension.git"
  },
  "description": "Adds \"Create Python Package\" to the right-click context menu",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.122.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "createPythonPackage.createPackage",
        "title": "Create Python Package"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "createPythonPackage.createPackage",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
